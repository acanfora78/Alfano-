# ─────────────────────────────────────────────────────────────
# Alfano Cars — variabili d'ambiente (copiare in .env.local)
# Nessun segreto va mai esposto con prefisso NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# URL pubblico del sito (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://alfanocars.it

# ── Invio richieste (modulo contatti) ────────────────────────
# Configurare ALMENO UNA destinazione. Senza destinazione il modulo
# risponde con errore 503 e propone WhatsApp/telefono: nessun invio simulato.

# Opzione A — email via Resend (https://resend.com), lato server
RESEND_API_KEY=
CONTACT_TO_EMAIL=alfanocars@gmail.com
# Mittente su un dominio verificato in Resend, es. "Sito Alfano Cars <sito@alfanocars.it>"
CONTACT_FROM_EMAIL=

# Opzione B — webhook generico (Make, Zapier, n8n, CRM): riceve JSON via POST
CONTACT_WEBHOOK_URL=
# Facoltativo: inviato come header "Authorization: Bearer <token>"
CONTACT_WEBHOOK_TOKEN=

# Richieste massime per IP ogni 10 minuti (anti-abuso)
CONTACT_RATE_LIMIT=5

# ── Inventario veicoli ───────────────────────────────────────
# Di default il sito legge content/vehicles.json.
# In alternativa un feed JSON remoto con lo stesso schema (es. export del gestionale).
VEHICLES_FEED_URL=
# Secondi di cache del feed remoto
VEHICLES_REVALIDATE=600

# ── Analytics (facoltativo, solo previo consenso) ────────────
# Se impostato compare il banner cookie; GA4 viene caricato solo dopo il consenso.
NEXT_PUBLIC_GA_ID=
